<Window x:Class="MiniAV.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniAV — Read-only Scanner" Height="570" Width="860" MinHeight="440" MinWidth="600">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="MiniAV — On-demand demo scanner" FontSize="21" FontWeight="SemiBold" />
      <TextBlock Text="Demo SHA-256 signatures only. NO_MATCH does not mean safe. Files are never changed."
                 Margin="0,5,0,14" TextWrapping="Wrap" />
      <TextBlock Text="File or directory" />
      <DockPanel Margin="0,3,0,9">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
          <Button x:Name="BrowseFileButton" Content="File..." Width="75" Click="BrowseFile_Click" />
          <Button x:Name="BrowseFolderButton" Content="Folder..." Width="75" Margin="6,0,0,0" Click="BrowseFolder_Click" />
        </StackPanel>
        <TextBox x:Name="TargetBox" />
      </DockPanel>
      <TextBlock Text="Signature database (JSON)" />
      <DockPanel Margin="0,3,0,12">
        <Button x:Name="BrowseDatabaseButton" Content="Browse..." Width="85" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseDatabase_Click" />
        <TextBox x:Name="DatabaseBox" />
      </DockPanel>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="StartButton" Content="Start scan" Width="110" Padding="8,5" Click="Start_Click" />
        <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Width="90" Margin="10,0,0,0"
                Padding="8,5" Click="Cancel_Click" />
        <Button x:Name="SaveLogButton" Content="Save log..." Width="105" Margin="10,0,0,0" Padding="8,5" IsEnabled="False" Click="SaveLog_Click" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Text="Ready" Margin="0,12,0,3" />
      <ProgressBar x:Name="BusyBar" Height="7" IsIndeterminate="True" Visibility="Collapsed" />
      <TextBlock x:Name="CountText" Text="Processed: 0 | Matched: 0 | No match: 0 | Skipped: 0 | Errors: 0" Margin="0,7,0,10" />
    </StackPanel>
    <TextBox x:Name="ResultsBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
             TextWrapping="NoWrap" />
  </DockPanel>
</Window>
