<Window x:Class="MiniAV.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniAV — Read-only Scanner" Height="760" Width="860" MinHeight="620" MinWidth="600">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="MiniAV — On-demand read-only scanner" FontSize="21" FontWeight="SemiBold" />
      <TextBlock Text="Demo Hash is default. Optional ClamAV requires a separately installed executable and database. NO_MATCH does not mean safe. MiniAV never intentionally modifies scanned files."
                 Margin="0,5,0,14" TextWrapping="Wrap" />
      <TextBlock Text="File or directory" />
      <DockPanel Margin="0,3,0,9">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
          <Button x:Name="BrowseFileButton" Content="File..." Width="75" Click="BrowseFile_Click" />
          <Button x:Name="BrowseFolderButton" Content="Folder..." Width="75" Margin="6,0,0,0" Click="BrowseFolder_Click" />
        </StackPanel>
        <TextBox x:Name="TargetBox" />
      </DockPanel>
      <TextBlock Text="Detection engine" />
      <ComboBox x:Name="EngineBox" SelectedIndex="0" Margin="0,3,0,9" SelectionChanged="EngineBox_SelectionChanged">
        <ComboBoxItem Content="Demo SHA-256 Hash (default)" />
        <ComboBoxItem Content="ClamAV (optional; locally installed)" />
      </ComboBox>
      <TextBlock Text="Hash demo signature database (JSON; only used for Hash)" />
      <DockPanel Margin="0,3,0,12">
        <Button x:Name="BrowseDatabaseButton" Content="Browse..." Width="85" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseDatabase_Click" />
        <TextBox x:Name="DatabaseBox" />
      </DockPanel>
      <TextBlock Text="ClamAV executable (absolute path to clamscan.exe; only for ClamAV)" />
      <DockPanel Margin="0,3,0,9">
        <Button x:Name="BrowseClamExecutableButton" Content="Browse..." Width="85" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseClamExecutable_Click" />
        <TextBox x:Name="ClamExecutableBox" />
      </DockPanel>
      <TextBlock Text="ClamAV signature directory (absolute path, optional)" />
      <DockPanel Margin="0,3,0,12">
        <Button x:Name="BrowseClamDatabaseButton" Content="Folder..." Width="85" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseClamDatabase_Click" />
        <TextBox x:Name="ClamDatabaseBox" />
      </DockPanel>
      <TextBlock Text="Optional limits (leave blank for unlimited)" Margin="0,0,0,4" />
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Max files" />
          <TextBox x:Name="MaxFilesBox" Width="125" ToolTip="Positive integer or blank" />
        </StackPanel>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Max file size (MiB)" />
          <TextBox x:Name="MaxFileMiBBox" Width="145" ToolTip="Positive integer MiB or blank" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Max scan time (seconds)" />
          <TextBox x:Name="MaxDurationBox" Width="155" ToolTip="Positive integer seconds or blank" />
        </StackPanel>
      </WrapPanel>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="StartButton" Content="Start scan" Width="110" Padding="8,5" Click="Start_Click" />
        <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Width="90" Margin="10,0,0,0"
                Padding="8,5" Click="Cancel_Click" />
        <Button x:Name="SaveLogButton" Content="Save log..." Width="105" Margin="10,0,0,0" Padding="8,5" IsEnabled="False" Click="SaveLog_Click" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Text="Ready" Margin="0,12,0,3" />
      <ProgressBar x:Name="BusyBar" Height="7" IsIndeterminate="True" Visibility="Collapsed" />
      <TextBlock x:Name="CountText" Text="Processed: 0 | Matched: 0 | No match: 0 | Skipped: 0 | Errors: 0" Margin="0,7,0,10" />
    </StackPanel>
    <TextBox x:Name="ResultsBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
             TextWrapping="NoWrap" />
  </DockPanel>
</Window>
